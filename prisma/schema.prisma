generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String    @id @default(cuid())
  username             String?
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  dailyGenerationCount Int       @default(0)
  lastGenerationDate   DateTime?
  dailyLimit           Int       @default(20)
  bio                  String?
  isAdmin              Boolean   @default(false)

  // YouTube lesson generation tracking
  youtubeGenerationCount    Int       @default(0)
  lastYoutubeGenerationDate DateTime?

  // Paddle Billing
  paddleCustomerId              String?   @unique
  subscriptionId                String?   @unique
  subscriptionStatus            String?   // active, canceled, past_due, paused, trialing
  subscriptionPlanId            String?   // Paddle price ID
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCancelAt          DateTime?

  accounts             Account[]
  sessions             Session[]
  students             Student[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  notifications        Notification[]
  youtubeLessons       YouTubeLesson[]
  placementAssignments PlacementTestAssignment[]
}

model Student {
  id             String         @id @default(cuid())
  name           String
  targetLanguage String
  nativeLanguage String
  ageGroup       String
  level          String
  endGoals       String
  occupation     String?
  weaknesses     String?
  interests      String?
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tutorId        String
  learningPlans  LearningPlan[]
  lessons        Lesson[]
  tutor          User           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  placementTests PlacementTestAssignment[]
}

model LearningPlan {
  id                   String   @id @default(cuid())
  selectedMethodology  String
  methodologyReasoning String
  topics               Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  studentId            String
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  overview  String?
  isRefined Boolean  @default(false)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sharedAt  DateTime?
  studentId String
  isPublic  Boolean? @default(false)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@unique([email, token])
  @@index([email])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([email, token])
  @@index([email])
  @@index([token])
}

model VocabularyAudio {
  id           String   @id @default(cuid())
  word         String   @unique
  audioUrl     String
  storageKey   String
  language     String   @default("en")
  createdAt    DateTime @default(now())

  @@index([word])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'student_added', 'lesson_generated', 'lesson_shared', 'plan_completed'
  title     String
  message   String
  link      String?  // URL to navigate to when clicked
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String
  excerpt     String?
  image       String?
  author      String   @default("Avidato Team")
  tags        String[] @default([])
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([published])
  @@index([slug])
}

model SharedYouTubeLesson {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model YouTubeLesson {
  id        String   @id @default(cuid())
  videoId   String
  sourceUrl String
  level     String
  title     String
  topic     String?
  data      Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([sourceUrl, level])
  @@index([level])
  @@index([createdAt])
}

// ================================================================
// Placement Test System
// ================================================================

model PlacementQuestion {
  id               String   @id @default(cuid())
  section          String   // 'grammar' | 'reading'
  cefrLevel        String   // A1, A2, B1, B2, C1, C2
  topic            String   // e.g. 'articles', 'conditionals'
  subtopic         String?  // e.g. 'zero conditional'
  difficulty       Int      // 1-60 linear scale
  stem             String   // question text
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctAnswer    String   // A | B | C | D
  explanation      String
  recommendedTopic String   // lesson topic to recommend on mistake
  readingPassageId String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  readingPassage ReadingPassage?  @relation(fields: [readingPassageId], references: [id], onDelete: SetNull)
  answers        PlacementAnswer[]

  @@index([section])
  @@index([cefrLevel])
  @@index([topic])
  @@index([difficulty])
  @@index([section, difficulty])
  @@index([section, cefrLevel])
}

model ReadingPassage {
  id        String   @id @default(cuid())
  cefrLevel String
  title     String
  content   String
  wordCount Int
  source    String?
  createdAt DateTime @default(now())

  questions PlacementQuestion[]
}

model PlacementTestAssignment {
  id              String    @id @default(cuid())
  studentId       String
  assignedById    String
  sections        String[]  // ['grammar'] or ['grammar','reading']
  status          String    @default("assigned") // assigned | in_progress | completed
  shareToken      String    @unique
  studentFullName String?
  emailOnComplete Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  completedAt     DateTime?

  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedBy User                     @relation(fields: [assignedById], references: [id], onDelete: Cascade)
  attempts   PlacementSectionAttempt[]
  result     PlacementTestResult?

  @@index([studentId])
  @@index([assignedById])
  @@index([shareToken])
  @@index([status])
}

model PlacementSectionAttempt {
  id                 String    @id @default(cuid())
  assignmentId       String
  section            String    // grammar | reading
  status             String    @default("not_started") // not_started | in_progress | completed
  currentLevel       String    @default("B1")
  questionsAsked     Int       @default(0)
  correctCount       Int       @default(0)
  consecutiveCorrect Int       @default(0)
  consecutiveWrong   Int       @default(0)
  determinedLevel    String?
  score              Float?
  startedAt          DateTime?
  completedAt        DateTime?
  timeSpentSecs      Int       @default(0)

  assignment PlacementTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers    PlacementAnswer[]

  @@unique([assignmentId, section])
  @@index([assignmentId])
}

model PlacementAnswer {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String   // A | B | C | D
  isCorrect      Boolean
  timeTakenSecs  Int      @default(0)
  questionOrder  Int
  createdAt      DateTime @default(now())

  attempt  PlacementSectionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PlacementQuestion       @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@index([questionId])
}

model PlacementTestResult {
  id              String   @id @default(cuid())
  assignmentId    String   @unique
  overallLevel    String
  grammarLevel    String?
  readingLevel    String?
  grammarScore    Float?
  readingScore    Float?
  strengths       String[] @default([])
  weaknesses      String[] @default([])
  recommendations Json     @default("[]")
  totalTimeSecs   Int      @default(0)
  certificateId   String?  @unique
  createdAt       DateTime @default(now())

  assignment PlacementTestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}